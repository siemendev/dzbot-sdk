{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "#generated": [
        "./generated/index.ts"
      ],
      "#generated/*": [
        "./generated/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
