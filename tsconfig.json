{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "#generated": ["./generated/index.ts"],
      "#generated/*": ["./generated/*"]
    }
  },
  "include": ["src", "test"]
}
